# The late routine's timer: 15:00 every day, on the Central clock whatever the host's zone. Persistent: a run
# missed while the host was down starts at boot, and the routine itself refuses when its window
# has passed.
[Unit]
Description=pickandroll late routine (15:00 every day Central)

[Timer]
OnCalendar=*-*-* 15:00:00 America/Chicago
AccuracySec=15s
Persistent=true
Unit=pickandroll-routine@late.service

[Install]
WantedBy=timers.target
