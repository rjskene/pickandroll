# The evening-build routine's timer: 21:00 every day, on the Central clock whatever the host's zone. Persistent: a run
# missed while the host was down starts at boot, and the routine itself refuses when its window
# has passed.
[Unit]
Description=pickandroll evening-build routine (21:00 every day Central)

[Timer]
OnCalendar=*-*-* 21:00:00 America/Chicago
AccuracySec=15s
Persistent=true
Unit=pickandroll-routine@evening-build.service

[Install]
WantedBy=timers.target
